# CivicLens Production Environment Variables

# ==========================================
# Backend Configuration
# ==========================================
# The URI of the MongoDB database. 
# Uses the docker internal network alias defined in docker-compose.yml
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=civiclens

# Security & CORS
SECRET_KEY=xyphx-civiclens-secure-key-2026
CORS_ORIGINS=https://anavandi.xyphx.com

# ==========================================
# Frontend Configuration
# ==========================================
# The public URL the frontend will use to hit the backend API (adjust to your EC2 IP / Domain)
NEXT_PUBLIC_API_URL=https://anavandi.xyphx.com/api

# The internal URL the frontend will use (via Docker DNS)
INTERNAL_BACKEND_URL=http://backend:8000

# Groq SDK API Key for CivicCare AI (Must be set by user)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
